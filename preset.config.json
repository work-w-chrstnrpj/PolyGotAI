  "contextRules": {
    "requiredCore": [
      {
        "file": "AGENTS.md",
        "checks": [
          { "pattern": "\\[State the project goal here\\.\\]", "invert": true, "message": "Project goal not set in AGENTS.md" },
          { "pattern": "\\[Runtime or framework\\]", "invert": true, "message": "Tech stack not specified in AGENTS.md" }
        ]
      },
      {
        "file": "docs/tdd/tdd.md",
        "checks": [
          { "pattern": "> Status: NOT_STARTED", "invert": true, "message": "docs/tdd/tdd.md is NOT_STARTED" }
        ]
      },
      {
        "file": "docs/project-structure/project-structure.md",
        "checks": [
          { "pattern": "> Status: NOT_STARTED", "invert": true, "message": "docs/project-structure/project-structure.md is NOT_STARTED" }
        ]
      }
    ],
    "conditionalTasks": {
      "api": {
        "file": "docs/api/api-specification.md",
        "name": "API specification",
        "roles": ["backend-database-engineer", "software-engineer"]
      },
      "database": {
        "file": "docs/database/data-model.md",
        "name": "Data model specification",
        "roles": ["backend-database-engineer"]
      },
      "deployment": {
        "file": "docs/deployment/deployment.md",
        "name": "Deployment configuration",
        "roles": ["devops-engineer"]
      },
      "testing": {
        "file": "docs/testing/test-specification.md",
        "name": "Testing specification",
        "roles": ["sqa-engineer"]
      }
    }
  }
}
